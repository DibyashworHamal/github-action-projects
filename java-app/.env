# --- DOCKER PORTS ---
# Because your application.properties says server.PORT=8081, the container must use 8081
CONTAINER_PORT=8081

# --- DATABASE OVERRIDES ---
# We point to mysql (the container name) and dip_db (the default db you created)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/dip_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=dip_hamal
SPRING_DATASOURCE_PASSWORD=dip_hamal123

# --- FILE UPLOADS OVERRIDE ---
# Overrides file.upload-dir. We change this to an absolute path inside the container so Docker can mount it securely.
FILE_UPLOAD_DIR=/app/uploads/organizer_docs

# --- GMAIL OVERRIDE ---
# Keeps your email password secure and out of version control
SPRING_MAIL_PASSWORD=vjfd ofub aayr xyob